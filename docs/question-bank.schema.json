{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "刷题小助手题库格式1.0",
  "description": "ID唯一性、章节引用、答案属于选项及B组一致性须另运行validate-banks.cjs检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "course",
    "chapters",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapterId",
          "type",
          "num",
          "stem",
          "options",
          "answers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "chapterId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "type": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "B",
              "X"
            ]
          },
          "num": {
            "type": "integer",
            "minimum": 1
          },
          "stem": {
            "type": "string",
            "pattern": "\\S"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-J]$"
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          },
          "answers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-J]$"
            }
          },
          "groupId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "sharedStem": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "X"
                }
              }
            },
            "then": {
              "properties": {
                "answers": {
                  "minItems": 2
                }
              }
            },
            "else": {
              "properties": {
                "answers": {
                  "maxItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
